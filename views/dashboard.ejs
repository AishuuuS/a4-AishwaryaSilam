<%- include('partials/header') %>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Your Habit Dashboard</h2>
        <a href="/auth/logout" class="btn btn-outline-danger">Logout</a>
    </div>

    <!-- Add Habit Form -->
    <div class="card shadow-sm mb-4 text-bg-dark">
        <div class="card-body">
            <h4 class="card-title mb-3">Add a New Habit</h4>
            <form action="/items" method="POST" class="row g-3">
                <div class="col-md-6">
                    <label for="name" class="form-label">Habit Name</label>
                    <input type="text" class="form-control" id="name" name="name" placeholder="e.g., Read 20 pages" required>
                </div>
                <div class="col-md-4">
                    <label for="frequency" class="form-label">Frequency (in Days)</label>
                    <input type="number" class="form-control" id="frequency" name="frequency" placeholder="e.g., 1" required>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">Add Habit</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Habits Table -->
    <div class="card shadow-sm text-bg-dark">
        <div class="card-body">
            <h4 class="card-title mb-3">Tracked Habits</h4>
            <% if (typeof items === 'undefined' || items.length === 0) { %>
                <p class="text-muted">No habits tracked yet. Add one above!</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Habit</th>
                                <th>Frequency</th>
                                <th>Next Due</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% items.forEach(item => { %>
                                <tr>
                                    <td><%= item.name %></td>
                                    <td>Every <%= item.frequency %> day(s)</td>
                                    <td><%= item.nextDue %></td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <!-- Inline Update Form -->
                                            <form action="/items/update/<%= item._id %>" method="POST" class="d-inline-flex gap-2">
                                                <input type="text" name="name" value="<%= item.name %>" class="form-control form-control-sm" style="width: 120px;" required>
                                                <input type="number" name="frequency" value="<%= item.frequency %>" class="form-control form-control-sm" style="width: 60px;" required>
                                                <button type="submit" class="btn btn-primary btn-sm">Update</button>
                                            </form>
                                            <!-- Delete Form -->
                                            <form action="/items/delete/<%= item._id %>" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('partials/footer') %>